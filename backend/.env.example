# 复制为 .env 并填入真实值（.env 切勿提交到仓库）

# 1) OpenAI（服务端持有，App 永不接触）
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
# 可选：走 OpenAI 兼容代理时改这里
OPENAI_BASE_URL=https://api.openai.com/v1

# 2) 服务端口
BACKEND_PORT=3000

# 3) 每日免费对话次数
FREE_DAILY_CHAT_LIMIT=5

# 4) Firebase Admin 凭据（二选一）
# 方式 A：服务账号 JSON 文件路径
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/serviceAccount.json
# 方式 B：直接内联服务账号 JSON（注意换行用 \n 或单行）
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# 5) RevenueCat
# Webhook 验签密钥（在 RevenueCat 后台 Project Settings > Webhooks 生成）
REVENUECAT_WEBHOOK_SECRET=whsec_xxxxxxxx
# RevenueCat API 密钥（主动同步订阅状态用，后台 API Keys）
REVENUECAT_SECRET=sk_xxxxxxxx
